<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Yes as a service</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600&display=swap" rel="stylesheet" />
    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: 'Noto Sans', sans-serif;
        color: #1e1e1e;
        background: #f8f8f8;
      }
      main { text-align: center; padding: 1.5rem; width: min(760px, 95vw); }
      h1 { margin: 0 0 2rem; font-size: 1.8rem; }
      fieldset { margin: 0; padding: 0; border: 0; }
      .kinds { display: grid; grid-auto-columns: auto; grid-template-columns: auto auto; text-align: left; margin-bottom: 2rem; }
      label { font-size: 0.95rem; }
      button {
        border: 1px solid #ccc;
        border-radius: 999px;
        background: #fff;
        padding: 0.45rem 0.85rem;
        cursor: pointer;
      }
      .phrase { margin-top: 1.4rem; min-height: 1.5em; font-size: 1.15rem; }

      .tabs { margin-top: 1rem; }
      .tab-input { position: absolute; opacity: 0; pointer-events: none; }
      .tab-labels { display: inline-flex; gap: 0; margin-bottom: 1rem; }
      .tab-labels label[for="tab-yes"] { border-top-right-radius: 0; border-bottom-right-radius: 0; }
      .tab-labels label[for="tab-no"] { border-top-left-radius: 0; border-bottom-left-radius: 0; }
      .tab-label {
        border: 1px solid #ccc;
        border-radius: 999px;
        background: #fff;
        padding: 0.45rem 0.9rem;
        cursor: pointer;
        font-weight: 600;
      }
      .tab-panel { display: none; }

      #tab-yes:checked ~ .tab-labels label[for="tab-yes"],
      #tab-no:checked ~ .tab-labels label[for="tab-no"] {
        background: #1e1e1e;
        color: #fff;
        border-color: #1e1e1e;
      }
      #tab-yes:checked ~ .panels .panel-yes { display: block; }
      #tab-no:checked ~ .panels .panel-no { display: block; }
    </style>
  </head>
  <body>
    <main>
      <h1>yaas.</h1>
      <section class="tabs">
        <input class="tab-input" type="radio" name="service-tab" id="tab-yes" <%= activeTab === 'yes' ? 'checked' : '' %> />
        <input class="tab-input" type="radio" name="service-tab" id="tab-no" <%= activeTab === 'no' ? 'checked' : '' %> />

        <div class="tab-labels" role="tablist" aria-label="Service tabs">
          <label class="tab-label" for="tab-yes" role="tab">Yes as a service</label>
          <label class="tab-label" for="tab-no" role="tab">No as a service</label>
        </div>

        <div class="panels">
          <section class="tab-panel panel-yes" role="tabpanel">
            <form method="GET" action="/">
              <input type="hidden" name="tab" value="yes" />
              <fieldset>
                <div class="kinds">
                  <label><input type="radio" name="yesKind" value="any" <%= selectedYesKind === 'any' ? 'checked' : '' %> /> Any</label>
                  <label><input type="radio" name="yesKind" value="agree" <%= selectedYesKind === 'agree' ? 'checked' : '' %> /> Agree</label>
                  <label><input type="radio" name="yesKind" value="confirm" <%= selectedYesKind === 'confirm' ? 'checked' : '' %> /> Confirm</label>
                  <label><input type="radio" name="yesKind" value="contradict" <%= selectedYesKind === 'contradict' ? 'checked' : '' %> /> Contradict</label>
                  <label><input type="radio" name="yesKind" value="encourage" <%= selectedYesKind === 'encourage' ? 'checked' : '' %> /> Encourage</label>
                </div>
              </fieldset>
              <p class="phrase"><%= yesPhrase %></p>
              <button type="submit" aria-label="Refresh yes phrase">&#x21bb; Refresh</button>
            </form>
          </section>

          <section class="tab-panel panel-no" role="tabpanel">
            <form method="GET" action="/">
              <input type="hidden" name="tab" value="no" />
              <fieldset>
                <div class="kinds">
                  <label><input type="radio" name="noKind" value="any" <%= selectedNoKind === 'any' ? 'checked' : '' %> /> Any</label>
                  <label><input type="radio" name="noKind" value="refuse" <%= selectedNoKind === 'refuse' ? 'checked' : '' %> /> Refuse</label>
                  <label><input type="radio" name="noKind" value="surprise" <%= selectedNoKind === 'surprise' ? 'checked' : '' %> /> Surprise</label>
                  <label><input type="radio" name="noKind" value="reinforce" <%= selectedNoKind === 'reinforce' ? 'checked' : '' %> /> Reinforce</label>
                </div>
              </fieldset>
              <p class="phrase"><%= noPhrase %></p>
              <button type="submit" aria-label="Refresh no phrase">&#x21bb; Refresh</button>
            </form>
          </section>
        </div>
      </section>
    </main>

    <script>
      (() => {
        const yesForm = document.querySelector('.panel-yes form');
        const noForm = document.querySelector('.panel-no form');
        const yesPhrase = document.querySelector('.panel-yes .phrase');
        const noPhrase = document.querySelector('.panel-no .phrase');
        const yesTab = document.getElementById('tab-yes');
        const noTab = document.getElementById('tab-no');

        const fetchPhrase = async (endpoint, params, phraseNode) => {
          const query = new URLSearchParams(params);
          const response = await fetch(`${endpoint}?${query.toString()}`);
          if (!response.ok) return;
          phraseNode.textContent = await response.text();
        };

        const activeTab = () => (noTab.checked ? 'no' : 'yes');

        yesForm.addEventListener('submit', async (event) => {
          if (activeTab() !== 'yes') return;
          event.preventDefault();
          const formData = new FormData(yesForm);
          const kind = formData.get('yesKind');
          const params = {};
          if (kind && kind !== 'any') params.kind = kind;
          await fetchPhrase('/yes', params, yesPhrase);
          const url = new URL(window.location.href);
          url.searchParams.set('tab', 'yes');
          if (kind && kind !== 'any') url.searchParams.set('yesKind', kind);
          else url.searchParams.delete('yesKind');
          window.history.replaceState({}, '', url);
        });

        noForm.addEventListener('submit', async (event) => {
          if (activeTab() !== 'no') return;
          event.preventDefault();
          const formData = new FormData(noForm);
          const kind = formData.get('noKind');
          const params = {};
          if (kind && kind !== 'any') params.kind = kind;
          await fetchPhrase('/no', params, noPhrase);
          const url = new URL(window.location.href);
          url.searchParams.set('tab', 'no');
          if (kind && kind !== 'any') url.searchParams.set('noKind', kind);
          else url.searchParams.delete('noKind');
          window.history.replaceState({}, '', url);
        });

        yesForm.addEventListener('change', (event) => {
          if (event.target.name === 'yesKind' && activeTab() === 'yes') {
            yesForm.requestSubmit();
          }
        });
        noForm.addEventListener('change', (event) => {
          if (event.target.name === 'noKind' && activeTab() === 'no') {
            noForm.requestSubmit();
          }
        });
      })();
    </script>
  </body>
</html>
